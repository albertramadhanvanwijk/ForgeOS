# ==========================================
# ForgeOS — Environment Configuration Template
# ==========================================

# Control Plane Orchestrator
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Web Application
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL + pgvector (via infrastructure/docker-compose.yml)
DATABASE_URL="postgresql://forgeos:forgeos_dev_password@localhost:5432/forgeos?schema=public"

# Redis Event Queue
REDIS_URL="redis://localhost:6379"

# Security & Policy Engine
JWT_SECRET="forgeos_super_secret_jwt_key_change_in_production"

# Artifact Storage
STORAGE_DRIVER="minio"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="forgeos_admin"
S3_SECRET_KEY="forgeos_storage_secret"
S3_BUCKET_NAME="forgeos-artifacts"
S3_REGION="us-east-1"

# Model Gateway Providers (Fill with your API keys as needed)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
LOCAL_LLM_URL="http://localhost:11434" # Ollama support

# Local Sandboxed Runner
RUNNER_TIMEOUT_MS=120000
RUNNER_MAX_CONCURRENCY=4
