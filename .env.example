# ==============================================================================
# ForgeOS — Environment Configuration Example (.env.example)
# Note: Keep this file free of real credentials. Copy to .env for local usage.
# ==============================================================================

# Node / Application
NODE_ENV=development
PORT=3000
API_PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://forgeos:forgeos_secret@localhost:5432/forgeos_dev?schema=public

# Object / Artifact Storage (MinIO / S3-compatible / Local)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./runtime-data/artifacts
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=forgeos-artifacts
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace_with_a_32_byte_hex_key_for_secrets_encryption

# Model Gateway Adapters (Optional in dev, set only what you use)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Sandboxed Execution & Local Runner
RUNNER_TYPE=local
RUNNER_TIMEOUT_MS=120000
RUNNER_MAX_MEMORY_MB=2048
RUNNER_WORKDIR=./runtime-data/runs

# Logging & Observability
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
