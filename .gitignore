# ──────────────────────────────────────────────
# ForgeOS — .gitignore
# ──────────────────────────────────────────────

# ── Runtime / generated data ──────────────────
runtime-data/

# ── Environment / secrets ─────────────────────
.env
.env.local
.env.*.local

# ── Node.js ───────────────────────────────────
node_modules/
dist/
build/
.next/
.nuxt/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── OS ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ──────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Docker / containers ───────────────────────
*.override.yml

# ── Temporary / scratch ───────────────────────
*.tmp
*.bak
*.orig

# ── Build caches ──────────────────────────────
*.tsbuildinfo
